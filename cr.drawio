        </mxCell>
        <mxCell id="qhUHqQQz3oVqzi-qmY4B-113" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;It uses a Lexer to split the source code into tokens, a Parser to build an AST, and a Translator to build a bytecode that will later be written to a file.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="qhUHqQQz3oVqzi-qmY4B-102" vertex="1">
          <mxGeometry x="10" y="50" width="300" height="70" as="geometry" />
        </mxCell>
