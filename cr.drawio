    <mxGraphModel dx="1386" dy="783" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="qhUHqQQz3oVqzi-qmY4B-86" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font&gt;CR&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;It is a compiled programming language with its own virtual runtime environment, which ensures memory safety and cross-platform compatibility. The language is aimed at ease of use and minimalism, thereby ensuring a low entry threshold and high speed of operation.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="760" height="150" as="geometry" />
        </mxCell>
        <mxCell id="qhUHqQQz3oVqzi-qmY4B-87" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Applications&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;" parent="1" vertex="1">
          <mxGeometry x="40" y="200" width="760" height="640" as="geometry" />
        </mxCell>
        <mxCell id="qhUHqQQz3oVqzi-qmY4B-88" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;CRC (CR Compiler)&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;The CRС compiles the CR code into bytecode, which can later be executed by a virtual machine.&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="qhUHqQQz3oVqzi-qmY4B-87" vertex="1">
          <mxGeometry x="10" y="50" width="740" height="110" as="geometry" />
        </mxCell>
        <mxCell id="qhUHqQQz3oVqzi-qmY4B-89" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;CRVM (CR Virtual Machine)&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;This is the runtime environment for CR bytecode. If the code has an entry point, then the code will be executed.&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="qhUHqQQz3oVqzi-qmY4B-87" vertex="1">
          <mxGeometry x="10" y="160" width="740" height="110" as="geometry" />
        </mxCell>
        <mxCell id="qhUHqQQz3oVqzi-qmY4B-90" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;CRBS (CR Build System)&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;The build system allows you to quickly compile the source code and assemble it into an executable file, avoiding unnecessary actions.&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="qhUHqQQz3oVqzi-qmY4B-87" vertex="1">
          <mxGeometry x="10" y="280" width="740" height="110" as="geometry" />
        </mxCell>
        <mxCell id="qhUHqQQz3oVqzi-qmY4B-91" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;CRPM (CR Package Manager)&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;The package manager allows you to use other people&#39;s libraries and frameworks in your projects, which can make it easier and faster to write code, and in some cases speed up the application.&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="qhUHqQQz3oVqzi-qmY4B-87" vertex="1">
          <mxGeometry x="10" y="390" width="740" height="130" as="geometry" />
        </mxCell>
        <mxCell id="qhUHqQQz3oVqzi-qmY4B-92" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;CRD (CR Debugger)&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;The debugger will allow you to stop your code at a certain line during execution, which will help you debug your code.&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="qhUHqQQz3oVqzi-qmY4B-87" vertex="1">
          <mxGeometry x="10" y="520" width="740" height="110" as="geometry" />
        </mxCell>
        <mxCell id="qhUHqQQz3oVqzi-qmY4B-94" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Libraries&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;" parent="1" vertex="1">
          <mxGeometry x="40" y="880" width="760" height="360" as="geometry" />
        </mxCell>
        <mxCell id="qhUHqQQz3oVqzi-qmY4B-95" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;ArgsParser&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;This library is used to manage application options passed through command line arguments.&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="qhUHqQQz3oVqzi-qmY4B-94" vertex="1">
          <mxGeometry x="10" y="50" width="740" height="110" as="geometry" />
        </mxCell>
        <mxCell id="qhUHqQQz3oVqzi-qmY4B-96" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;ErrorManager&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Stores the error code and text.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="qhUHqQQz3oVqzi-qmY4B-94" vertex="1">
          <mxGeometry x="10" y="170" width="740" height="80" as="geometry" />
