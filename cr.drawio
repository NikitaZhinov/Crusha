        <mxCell id="qhUHqQQz3oVqzi-qmY4B-111" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SyntaxAnalizer&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Checks the code for syntax errors.&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="qhUHqQQz3oVqzi-qmY4B-102" vertex="1">
