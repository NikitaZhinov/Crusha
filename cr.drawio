        <mxCell id="qhUHqQQz3oVqzi-qmY4B-110" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Parser&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;It takes a list of tokens and builds an abstract syntax tree.&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="qhUHqQQz3oVqzi-qmY4B-102" vertex="1">
