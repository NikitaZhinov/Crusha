        <mxCell id="qhUHqQQz3oVqzi-qmY4B-97" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Lexer&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;It is used to split the contents of a file into tokens for later use.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="qhUHqQQz3oVqzi-qmY4B-94" vertex="1">
